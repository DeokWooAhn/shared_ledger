rules_version = '2';

// 구조와 역할 설명은 docs/firestore.md, 테스트는 firestore-tests/rules.test.js.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 ----------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // 커플·부부 가계부라 한 가계부에는 두 명까지 들어온다. 앱의 ledgerMaxMembers와 같다.
    function maxMembers() {
      return 2;
    }

    function ledgerData(ledgerId) {
      return get(/databases/$(database)/documents/ledgers/$(ledgerId)).data;
    }

    // 이 요청(일괄 쓰기 포함)이 끝난 뒤의 가계부. 가계부를 만들면서 기본 설정을 같은 일괄 쓰기로 넣을 때 쓴다.
    // 일괄 쓰기의 쓰기마다 따로 규칙을 통과해야 하므로, 남의 가계부를 이 방법으로 고칠 수는 없다.
    function ledgerDataAfter(ledgerId) {
      return getAfter(/databases/$(database)/documents/ledgers/$(ledgerId)).data;
    }

    function isMemberOf(ledger) {
      return signedIn() && uid() in ledger.memberUids;
    }

    // 관리자와 편집자만 쓸 수 있다.
    function canWriteIn(ledger) {
      return signedIn()
        && (ledger.ownerUid == uid() || ledger.roles.get(uid(), '') == 'editor');
    }

    // 만들 때: 작성자는 나, 시간은 서버 시간.
    function createdNow() {
      let data = request.resource.data;
      return data.createdBy == uid()
        && data.updatedBy == uid()
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // 고칠 때: 처음 작성 기록은 그대로, 마지막 수정자는 나.
    function updatedNow() {
      let data = request.resource.data;
      return data.createdBy == resource.data.createdBy
        && data.createdAt == resource.data.createdAt
        && data.updatedBy == uid()
        && data.updatedAt == request.time;
    }

    // ---------- 가계부 ----------

    // 가계부를 만들 때 받는 달 목록: 비었거나, 처음 고른 달(yyyy-MM) 하나(2026-10-29).
    function createsMonths(months) {
      return months is list
        && (months.size() == 0
          || (months.size() == 1 && months[0] is string && months[0].matches('[0-9]{4}-(0[1-9]|1[0-2])')));
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    // memberUids = 관리자 + roles의 키. roles 값은 편집자·보기 전용만. 두 명까지.
    function consistentMembers(data) {
      return data.ownerUid is string
        && data.roles is map
        && data.memberUids is list
        && !(data.ownerUid in data.roles)
        && data.roles.values().hasOnly(['editor', 'viewer'])
        && data.memberUids.size() == data.roles.size() + 1
        && data.memberUids.size() <= maxMembers()
        && data.memberUids.toSet() == data.roles.keys().toSet().union([data.ownerUid].toSet());
    }

    match /ledgers/{ledgerId} {
      allow get: if isMemberOf(resource.data);
      // '내 가계부 목록'은 memberUids array-contains 조회로만 읽는다.
      allow list: if signedIn() && uid() in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'roles', 'memberUids', 'months', 'createdAt', 'updatedAt'])
        && createsMonths(request.resource.data.get('months', []))
        && validName(request.resource.data.name)
        && request.resource.data.ownerUid == uid()
        && request.resource.data.roles == {}
        && request.resource.data.memberUids == [uid()]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // 관리자: 이름 변경, 역할 변경, 내보내기. 구성원을 직접 추가할 수는 없다(초대로만).
      function ownerManages() {
        let before = resource.data;
        let after = request.resource.data;
        return signedIn()
          && before.ownerUid == uid()
          && after.diff(before).affectedKeys().hasOnly(['name', 'roles', 'memberUids', 'updatedAt'])
          && validName(after.name)
          && consistentMembers(after)
          && after.roles.diff(before.roles).addedKeys().size() == 0
          && after.updatedAt == request.time;
      }

      // 편집자·보기 전용: 스스로 나가기.
      function leavesSelf() {
        let before = resource.data;
        let after = request.resource.data;
        let rolesDiff = after.roles.diff(before.roles);
        return signedIn()
          && uid() in before.roles
          && after.diff(before).affectedKeys().hasOnly(['roles', 'memberUids', 'updatedAt'])
          && rolesDiff.affectedKeys() == [uid()].toSet()
          && rolesDiff.removedKeys() == [uid()].toSet()
          && after.memberUids.size() == before.memberUids.size() - 1
          && after.memberUids.toSet() == before.memberUids.toSet().difference([uid()].toSet())
          && after.updatedAt == request.time;
      }

      // 초대 코드로 참여: 자리가 있을 때, 자기 uid만, 초대에 적힌 역할로.
      function joinsWithInvite() {
        let before = resource.data;
        let after = request.resource.data;
        let invite = get(/databases/$(database)/documents/invites/$(after.inviteCode)).data;
        let rolesDiff = after.roles.diff(before.roles);
        return signedIn()
          && !(uid() in before.memberUids)
          && before.memberUids.size() < maxMembers()
          && after.diff(before).affectedKeys().hasOnly(['roles', 'memberUids', 'inviteCode', 'updatedAt'])
          && invite.ledgerId == ledgerId
          && invite.expiresAt > request.time
          && rolesDiff.addedKeys() == [uid()].toSet()
          && rolesDiff.affectedKeys() == [uid()].toSet()
          && after.roles[uid()] == invite.role
          && after.memberUids == before.memberUids.concat([uid()])
          && after.updatedAt == request.time;
      }

      // 관리자·편집자: 항목 있는 달 목록(months)에 달을 더한다. 빼거나 다른 칸을 같이 고칠 수는 없다.
      // 그달에 처음 항목을 넣을 때 arrayUnion으로 하나씩 더하고, 목록이 없던 가계부는 처음 열 때 여러 달을 한 번에 적는다.
      function recordsMonths() {
        let before = resource.data.get('months', []);
        let after = request.resource.data.get('months', []);
        return canWriteIn(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['months'])
          && after is list
          && after.size() <= 1200
          && after.toSet().size() == after.size()
          && after.hasAll(before)
          && (after.size() == 0
            || after.join(',').matches('[0-9]{4}-(0[1-9]|1[0-2])(,[0-9]{4}-(0[1-9]|1[0-2]))*'));
      }

      allow update: if ownerManages() || leavesSelf() || joinsWithInvite() || recordsMonths();
      allow delete: if signedIn() && resource.data.ownerUid == uid();

      // ---------- 가계부 설정: 구성원 이름표, 분류, 결제수단, 고정 지출 템플릿 ----------

      match /{settings}/{docId} {
        function isSettings() {
          return settings in ['members', 'categories', 'paymentMethods', 'templates'];
        }

        // 이름표는 두 사람 몫 두 장뿐이다: owner(관리자), partner(초대로 들어온 사람). 이름은 1~10자.
        function validMember() {
          let name = request.resource.data.get('name', null);
          return settings != 'members'
            || (docId in ['owner', 'partner'] && name is string && name.size() >= 1 && name.size() <= 10);
        }

        function settingText(field, max) {
          let value = request.resource.data.get(field, null);
          return value is string && value.size() >= 1 && value.size() <= max;
        }

        // 반복 설정(템플릿): 앱의 newTemplateData(lib/data/templates/firestore_templates_repository.dart)와 같은 필드만 받는다.
        // kind가 없으면 고정 지출, 'income'이면 고정 수입(2026-10-29)이다. 예정일은 1~31일(31은 말일)이다.
        // 고정 지출의 금액은 0 이상의 정수이거나 비어 있다(금액 미정). 고정 수입은 분류·결제수단이 없고 금액을 꼭 적는다.
        function validTemplate() {
          let data = request.resource.data;
          let amount = data.get('amount', null);
          let dueDay = data.get('dueDay', null);
          let income = data.get('kind', null) == 'income';
          return settings != 'templates'
            || ((income
                  ? data.keys().hasOnly(['kind', 'title', 'amount', 'memberId', 'dueDay',
                      'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
                    && amount is int && amount >= 0
                  : data.keys().hasOnly(['title', 'amount', 'categoryId', 'paymentMethodId', 'memberId', 'dueDay',
                      'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
                    && (amount == null || (amount is int && amount >= 0))
                    && settingText('categoryId', 100)
                    && settingText('paymentMethodId', 100))
              && settingText('title', 40)
              && data.get('memberId', null) in ['owner', 'partner']
              && dueDay is int && dueDay >= 1 && dueDay <= 31);
        }

        function validOrder() {
          let order = request.resource.data.get('order', null);
          return order is int && order >= 0;
        }

        // 숨긴 분류·결제수단은 새로 고를 수 없을 뿐, 지난 항목과 합계에는 그대로 쓰인다.
        function validHidden() {
          let data = request.resource.data;
          return !('hidden' in data) || data.hidden is bool;
        }

        // 분류: 앱의 newCategoryData(lib/core/data/settings_repository.dart)와 같은 필드만 받는다. 이름은 1~20자.
        function validCategory() {
          let data = request.resource.data;
          return settings != 'categories'
            || (data.keys().hasOnly(['name', 'countsAsSaving', 'order', 'hidden',
                  'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
              && settingText('name', 20)
              && data.get('countsAsSaving', null) is bool
              && validOrder()
              && validHidden());
        }

        // 결제수단: 앱의 newPaymentMethodData와 같은 필드만 받는다. 이름은 1~20자.
        function validPaymentMethod() {
          let data = request.resource.data;
          return settings != 'paymentMethods'
            || (data.keys().hasOnly(['name', 'kind', 'order', 'hidden',
                  'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
              && settingText('name', 20)
              && data.get('kind', null) in ['account', 'autoTransfer', 'card']
              && validOrder()
              && validHidden());
        }

        // 결제수단 종류는 바꿀 수 없다. 카드인지에 따라 지난 달 계산이 달라진다.
        // 반복 설정의 종류(고정 지출·고정 수입)도 바꿀 수 없다. 그달 항목이 종류별 컬렉션에 있다.
        function keepsKind() {
          return (settings != 'paymentMethods' || request.resource.data.kind == resource.data.kind)
            && (settings != 'templates'
              || request.resource.data.get('kind', null) == resource.data.get('kind', null));
        }

        function validSetting() {
          return validMember() && validTemplate() && validCategory() && validPaymentMethod();
        }

        allow read: if isSettings() && isMemberOf(ledgerData(ledgerId));
        allow create: if isSettings() && canWriteIn(ledgerDataAfter(ledgerId)) && createdNow()
          && validSetting();
        allow update: if isSettings() && canWriteIn(ledgerData(ledgerId)) && updatedNow()
          && validSetting() && keepsKind();
        // 고정 지출만 지운다. 이름표·분류·결제수단은 지난 항목이 가리키고 있어서 숨기기만 한다.
        allow delete: if settings == 'templates' && canWriteIn(ledgerData(ledgerId));
      }

      // ---------- 가계부 항목: months/{yyyy-MM}/{종류}/{id} ----------

      match /months/{month}/{entryType}/{entryId} {
        function isEntryType() {
          return entryType in ['incomes', 'fixedIncomes', 'planned', 'extras', 'cardBills'];
        }

        function validMonth() {
          return month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
        }

        // 금액은 0 이상의 정수(원). 고정 지출(planned)만 비워 둘 수 있다.
        function validAmount() {
          let amount = request.resource.data.get('amount', null);
          return (entryType == 'planned' && amount == null)
            || (amount is int && amount >= 0);
        }

        // 휴지통: deletedAt은 넣은 시간. purgeAt은 TTL 정책이 지울 때이고, 휴지통에 있을 때만 적는다.
        // 그래서 휴지통 밖의 항목은 TTL로도 지워지지 않는다(완전 삭제는 휴지통 항목만).
        function validTrash() {
          let deletedAt = request.resource.data.get('deletedAt', null);
          let purgeAt = request.resource.data.get('purgeAt', null);
          return (deletedAt == null || deletedAt is timestamp)
            && (purgeAt == null || (purgeAt is timestamp && deletedAt != null));
        }

        // 종류마다 받는 필드. 앱의 newEntryData(lib/core/data/entries_repository.dart)와 같다.
        // 고정 지출·고정 수입의 dueOn은 반복 설정에서 옮긴 그달 예정일이다. 고정 수입은 2026-10-29부터다.
        function entryFields() {
          let common = ['memberId', 'amount', 'memo', 'deletedAt', 'purgeAt', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'];
          return entryType == 'incomes' ? common.concat(['title', 'receivedOn'])
            : entryType == 'fixedIncomes' ? common.concat(['title', 'receivedOn', 'dueOn'])
            : entryType == 'planned' ? common.concat(['title', 'categoryId', 'paymentMethodId', 'paidOn', 'dueOn'])
            : entryType == 'extras' ? common.concat(['title', 'paymentMethodId', 'spentOn'])
            : common.concat(['cardId', 'paidOn']);
        }

        function textUpTo(field, max) {
          let value = request.resource.data.get(field, null);
          return value is string && value.size() >= 1 && value.size() <= max;
        }

        function optionalTextUpTo(field, max) {
          let value = request.resource.data.get(field, null);
          return value == null || (value is string && value.size() <= max);
        }

        // 날짜는 '2026-10-25' 같은 문자열(선택). 받지 않는 종류의 날짜 칸은 entryFields가 막는다.
        function validDate(field) {
          let value = request.resource.data.get(field, null);
          return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
        }

        // 누가는 이름표 자리(owner·partner). 제목은 카드대금 말고 모두 1~40자, 메모는 200자까지.
        // 분류·결제수단·카드 칸은 그 종류에 꼭 있어야 한다.
        function validEntry() {
          let data = request.resource.data;
          return data.keys().hasOnly(entryFields())
            && data.get('memberId', null) in ['owner', 'partner']
            && (entryType == 'cardBills' || textUpTo('title', 40))
            && optionalTextUpTo('memo', 200)
            && (entryType != 'planned' || (textUpTo('categoryId', 100) && textUpTo('paymentMethodId', 100)))
            && (entryType != 'extras' || textUpTo('paymentMethodId', 100))
            && (entryType != 'cardBills' || textUpTo('cardId', 100))
            && validDate('receivedOn')
            && validDate('paidOn')
            && validDate('spentOn')
            && validDate('dueOn')
            && validAmount()
            && validTrash();
        }

        allow read: if isEntryType() && isMemberOf(ledgerData(ledgerId));
        allow create: if isEntryType()
          && validMonth()
          && canWriteIn(ledgerData(ledgerId))
          && createdNow()
          && validEntry();
        // 고칠 때도 고친 뒤의 문서 전체를 같은 기준으로 본다.
        allow update: if isEntryType()
          && canWriteIn(ledgerData(ledgerId))
          && updatedNow()
          && validEntry();
        // 휴지통(deletedAt)에 있는 항목만 완전히 지울 수 있다.
        allow delete: if isEntryType()
          && canWriteIn(ledgerData(ledgerId))
          && resource.data.get('deletedAt', null) != null;
      }

      // ---------- 변경 기록: 추가만 가능 ----------

      // 앱의 newActivityData(lib/core/data/activity_repository.dart)와 같은 필드만 받는다.
      // 앱은 항목·설정을 쓸 때 같은 일괄 쓰기·트랜잭션으로 남긴다. expireAt이 지나면(1년) TTL 정책이 지운다.
      // expireAt은 지난 시각(바로 지워짐)이나 400일 넘게 먼 시각을 막는다. 앱은 기기 시각 + 365일을 적고,
      // 오프라인에서 더한 항목은 나중에 서버에 닿으므로 하한은 '요청보다 뒤'로 넉넉히 둔다.
      match /activity/{activityId} {
        function validActivity() {
          let data = request.resource.data;
          let action = data.get('action', null);
          let summary = data.get('summary', null);
          return data.keys().hasOnly(['actorUid', 'at', 'action', 'summary', 'expireAt'])
            && data.get('actorUid', null) == uid()
            && data.get('at', null) == request.time
            && action is string && action.size() <= 40 && action.matches('^[a-z][a-zA-Z]*[.][a-z][a-zA-Z]*$')
            && summary is string && summary.size() >= 1 && summary.size() <= 200
            && data.get('expireAt', null) is timestamp
            && data.expireAt > request.time
            && data.expireAt <= request.time + duration.value(400, 'd');
        }

        allow read: if isMemberOf(ledgerData(ledgerId));
        allow create: if canWriteIn(ledgerData(ledgerId)) && validActivity();
        allow update, delete: if false;
      }
    }

    // ---------- 초대 ----------

    match /invites/{code} {
      // 관리자만, 자리가 남은 가계부에, 7일 이내로 만든다.
      function createsInvite() {
        let data = request.resource.data;
        let ledger = ledgerData(data.ledgerId);
        return signedIn()
          && code.matches('^[A-Za-z0-9]{8,32}$')
          && data.keys().hasOnly(['ledgerId', 'role', 'createdBy', 'createdAt', 'expiresAt'])
          && data.ledgerId is string
          && ledger.ownerUid == uid()
          && ledger.memberUids.size() < maxMembers()
          && data.role in ['editor', 'viewer']
          && data.createdBy == uid()
          && data.createdAt == request.time
          && data.expiresAt is timestamp
          && data.expiresAt > request.time
          && data.expiresAt <= request.time + duration.value(7, 'd');
      }

      // 코드를 아는 사람만 한 건씩 읽는다. 목록 조회는 막는다.
      allow get: if signedIn();
      allow list: if false;

      allow create: if createsInvite();
      allow update: if false;
      allow delete: if signedIn() && ledgerData(resource.data.ledgerId).ownerUid == uid();
    }

    // ---------- 공휴일 ----------

    // 연도별 공휴일(holidays/2026). Cloud Functions(syncHolidays)가 관리자 권한으로 쓰고, 앱은 그해 문서 하나만 읽는다.
    match /holidays/{year} {
      allow get: if signedIn();
      allow list, write: if false;
    }
  }
}
